# ───────────────────────────────────────────────
# ContextOS Environment Variables
# Copy to .env and fill in your values
# ───────────────────────────────────────────────

# Set to "false" to use real Coral data (requires Coral CLI + sources)
# Set to "true" to run with built-in realistic mock data (no Coral needed)
MOCK_MODE=false

# OpenRouter API key (for /api/briefing synthesis)
# If not set, a fallback rule-based briefing is used
OPENROUTER_API_KEY=sk-or-...

# GitHub source — required for github.issues and github.pulls queries
GITHUB_ENABLED=false
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-main-repo-name

# Discord custom source (optional — only needed if you add the Discord source)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Coral CLI config directory (defaults to ~/.coral if not set)
# CORAL_CONFIG_DIR=~/.coral

# Backend port (default: 3001)
PORT=3001
